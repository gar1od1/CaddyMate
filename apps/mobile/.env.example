# Copy to .env and fill in. Values prefixed EXPO_PUBLIC_ are embedded in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://mceverccxohligbwpdwd.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional: Mapbox satellite tiles. Leave empty to use ESRI World Imagery.
EXPO_PUBLIC_MAPBOX_TOKEN=
# Optional: Sentry error reporting (decision 008). Leave empty to keep Sentry off.
EXPO_PUBLIC_SENTRY_DSN=
# Optional: Sentry environment (default: development in dev builds, production otherwise).
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
