        <label x="center" y="38%" text="@Strings.WaitingTitle" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE"/>
        <label x="center" y="56%" text="@Strings.WaitingBody" font="Graphics.FONT_XTINY" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_LT_GRAY"/>
    </layout>
</layouts>
